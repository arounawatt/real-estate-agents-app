{
  "name": "codaya-agents",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:apps": "pnpm --parallel --filter \"./apps/*\" dev",
    "clean": "bash scripts/clean.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @codaya/db generate",
    "db:migrate": "pnpm --filter @codaya/db migrate",
    "db:seed": "pnpm --filter @codaya/db seed",
    "ops:user": "pnpm --filter @codaya/ops user",
    "ops:tenant": "pnpm --filter @codaya/ops tenant",
    "ops:tenant-status": "pnpm --filter @codaya/ops tenant-status",
    "ops:whatsapp": "pnpm --filter @codaya/ops whatsapp",
    "ops:whatsapp-token": "pnpm --filter @codaya/ops whatsapp-token",
    "ops:onboard": "pnpm --filter @codaya/ops onboard"
  }
}
