############################################################
#  codaya-agents — variables d'environnement
#
#  Copier en `.env` et compléter.  `.env` est ignoré par Git.
#  Toute valeur marquée À OBTENIR demande une démarche externe :
#  elles sont listées dans README.md avec leur délai.
############################################################


# ─────────────────────────────────────────────────────────
#  Base de données — Supabase, région UE obligatoire
# ─────────────────────────────────────────────────────────
# La région doit être dans l'Union européenne (Francfort ou Irlande).
# Ce n'est pas une préférence : aucun pays africain ne bénéficie d'une
# décision d'adéquation, donc héberger au Sénégal imposerait des clauses
# contractuelles types et une analyse de transfert.  Voir le document
# de conformité.
DATABASE_URL=
# Connexion directe (port 5432, sans pooler) — Drizzle en a besoin
# pour les migrations.
DIRECT_URL=


# ─────────────────────────────────────────────────────────
#  Anthropic
# ─────────────────────────────────────────────────────────
# La clé est celle de Codaya, jamais celle du client : décision
# documentée dans architecture-technique-saas.md.  Demander à une
# agence de Dakar d'ouvrir un compte avec une carte en dollars
# retarde ou tue une vente déjà signée.
ANTHROPIC_API_KEY=
# Modèle par défaut.  Le coût a été calculé sur Haiku 4.5 :
# ~9 000 FCFA pour 300 conversations, soit ~6 % de l'Essentiel.
ANTHROPIC_MODEL=claude-haiku-4-5


# ─────────────────────────────────────────────────────────
#  Meta — WhatsApp Cloud API                    (À OBTENIR)
# ─────────────────────────────────────────────────────────
# Prérequis longs, à lancer très en amont du premier client :
#   · vérification commerciale du Business Manager
#   · App Review pour whatsapp_business_management
#     et whatsapp_business_messaging
# Sans accès avancé approuvé, aucun onboarding client n'est possible.
META_APP_ID=
# Sert à vérifier la signature X-Hub-Signature-256 de chaque webhook.
# Un webhook non vérifié est une porte ouverte : toute requête pourrait
# se faire passer pour Meta.
META_APP_SECRET=
# Chaîne que TU choisis et que tu recopies dans la configuration du
# webhook côté Meta.  Elle ne sert qu'à la poignée de main initiale.
META_WEBHOOK_VERIFY_TOKEN=
# Token du system user Tech Provider, utilisé pour l'Embedded Signup
# et pour pousser la bibliothèque de templates sur le WABA du client.
META_SYSTEM_USER_TOKEN=
# Version de l'API Graph.  À vérifier dans la documentation Meta au
# moment de l'installation — elle change plusieurs fois par an.
META_API_VERSION=
# URL publique qui reçoit les webhooks.  En développement, un tunnel
# (ngrok ou équivalent) ; en production, le domaine du service worker.
WEBHOOK_PUBLIC_URL=


# ─────────────────────────────────────────────────────────
#  Chiffrement des secrets par tenant
# ─────────────────────────────────────────────────────────
# Les tokens Meta de chaque agence sont chiffrés au repos en base.
# Générer :  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────
#  Stockage des médias — Cloudflare R2 ou S3
# ─────────────────────────────────────────────────────────
# Meta ne donne qu'un media_id et l'URL expire : les photos envoyées
# par les locataires doivent être téléchargées IMMÉDIATEMENT et
# stockées.  Un worker qui rate ce téléchargement perd la photo
# définitivement.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ─────────────────────────────────────────────────────────
#  Authentification du tableau de bord
# ─────────────────────────────────────────────────────────
# Générer :  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────────────────
# Base des liens profonds (/leads/:id, /tickets/:id).  Ces liens
# ouvrent le tableau de bord, qui exige une session : un lien envoyé
# sur WhatsApp ne doit jamais être un lien public devinable.
APP_URL=http://localhost:3000

NODE_ENV=development
LOG_LEVEL=info


# ─────────────────────────────────────────────────────────
#  Session — STUB DE DÉVELOPPEMENT, PAS UNE AUTHENTIFICATION
# ─────────────────────────────────────────────────────────
# Il n'y a pas encore de vraie authentification (Auth.js / Clerk / Supabase
# Auth non arbitré, voir architecture-technique-saas.md). En attendant,
# apps/dashboard/lib/session.ts lit ce tenant unique pour tout accès.
# Remplir avec l'id renvoyé par `pnpm db:seed`.
# À supprimer dès qu'une vraie session existe — ne doit jamais servir de
# base à un accès multi-utilisateur ni à l'envoi d'un lien WhatsApp.
DEV_TENANT_ID=
